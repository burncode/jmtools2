      { "id": "providerId", "label": "文本服务商 ID", "type": "text", "defaultValue": "" },
      { "id": "model", "label": "文本模型", "type": "text", "defaultValue": "" }
    ]
  },
  {
    "id": "ai.imageGenerate",
    "label": "AI 生图",
    "category": "ai",
    "color": "ai",
    "description": "根据提示词生成图片并写入项目生成目录。",
