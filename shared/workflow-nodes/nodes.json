[
  {
    "id": "image.input",
    "label": "图片输入",
    "category": "input",
    "color": "input",
    "description": "读取项目内或本机图片路径，作为图像处理链路的起点。",
    "helpText": "用于把已有图片送入工作流。项目相对路径会从当前 JMTools 项目根目录解析。",
    "status": "available",
    "inputs": [],
    "outputs": [{ "id": "image", "kind": "image", "label": "图片" }],
    "params": [
      {
        "id": "sourceKind",
        "label": "路径类型",
        "type": "select",
        "defaultValue": "projectRelativePath",
        "options": [
          { "label": "项目相对路径", "value": "projectRelativePath" },
          { "label": "本机绝对路径", "value": "absolutePath" }
        ]
      },
      {
        "id": "path",
        "label": "图片路径",
        "type": "text",
        "widget": "projectPath",
        "required": true,
        "description": "项目相对路径示例：assets/images/source.png",
        "defaultValue": ""
      }
    ]
  },
  {
    "id": "tool.backgroundRemoval",
    "label": "去背景",
    "category": "tool",
    "color": "tool",
    "description": "复用 JMTools 通用去背景工具，输出透明 PNG 和质量报告。",
    "helpText": "首版执行已有素材工具能力。复杂精修仍建议跳转到素材工具专用视图处理。",
    "status": "available",
    "inputs": [{ "id": "input", "kind": "image", "label": "输入" }],
    "outputs": [
      { "id": "image", "kind": "image", "label": "图片" },
      { "id": "toolResult", "kind": "toolResult", "label": "结果" }
    ],
    "params": [
      { "id": "engine", "label": "算法", "type": "select", "defaultValue": "chroma", "options": [{ "label": "快速纯色背景", "value": "chroma" }, { "label": "AI 语义去背景", "value": "rembg" }] },
      { "id": "tolerance", "label": "容差", "type": "number", "widget": "slider", "defaultValue": 34, "min": 4, "max": 96 },
      { "id": "edgeSoftness", "label": "边缘柔化", "type": "number", "widget": "slider", "defaultValue": 24, "min": 0, "max": 96 },
      { "id": "cleanupStrength", "label": "碎点清理", "type": "select", "defaultValue": "standard", "options": [{ "label": "关闭", "value": "off" }, { "label": "轻度", "value": "soft" }, { "label": "标准", "value": "standard" }, { "label": "严格", "value": "strict" }] },
      { "id": "holeFillMaxPixels", "label": "孔洞填补", "type": "number", "widget": "slider", "defaultValue": 128, "min": 0, "max": 4096 },
      { "id": "spillSuppression", "label": "残色抑制", "type": "number", "widget": "slider", "defaultValue": 45, "min": 0, "max": 100 },
      { "id": "preserveSmallParts", "label": "保留小部件", "type": "boolean", "defaultValue": false }
    ]
  },
  {
    "id": "character.load",
    "label": "读取角色",
    "category": "character",
    "color": "asset",
    "description": "读取项目中的角色资产记录，用于后续后处理或绑定。",
    "helpText": "需要填写已有角色 ID。此节点只读取角色记录，不修改项目资产。",
    "status": "available",
    "inputs": [],
    "outputs": [{ "id": "character", "kind": "character", "label": "角色" }],
    "params": [{ "id": "characterId", "label": "角色 ID", "type": "text", "widget": "characterRef", "required": true, "defaultValue": "" }]
  },
  {
    "id": "character.bindToolResult",
    "label": "绑定角色结果",
    "category": "character",
    "color": "asset",
    "description": "把上游工具结果绑定到角色视图，写入透明图和处理元数据。",
    "helpText": "需要上游工具结果和目标角色 ID。运行后可从节点结果打开角色工坊继续精修。",
