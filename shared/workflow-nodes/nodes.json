    ],
    "outputs": [{ "id": "output", "kind": "image", "label": "输出" }],
    "params": []
  },
  {
    "id": "preview.actionSequence",
    "label": "动作序列预览",
    "category": "preview",
    "color": "preview",
    "description": "预览角色动作帧序列，支持按方向切换与帧条检查。",
    "helpText": "接入 character 输出；透传角色供下游导出。生成动作请使用「生成动作帧」节点。",
