      { "id": "character", "kind": "character", "label": "角色" },
      { "id": "toolResult", "kind": "toolResult", "label": "工具结果" }
    ],
    "outputs": [{ "id": "character", "kind": "character", "label": "角色" }],
    "params": [
      { "id": "characterId", "label": "角色 ID", "type": "text", "widget": "characterRef", "required": false, "defaultValue": "" },
      { "id": "viewId", "label": "视图 ID", "type": "text", "description": "留空时使用当前记录的默认视图。", "defaultValue": "" }
    ]
  },
  {
    "id": "ai.prompt",
    "label": "AI 提示词",
    "category": "ai",
    "color": "ai",
