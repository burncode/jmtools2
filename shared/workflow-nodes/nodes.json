      { "id": "characterClass", "label": "职业", "type": "select", "defaultValue": "warrior", "options": [{ "label": "战士", "value": "warrior" }, { "label": "法师", "value": "mage" }, { "label": "弓手", "value": "archer" }, { "label": "自定义", "value": "custom" }] }
    ]
  },
  {
    "id": "character.styleProfile",
