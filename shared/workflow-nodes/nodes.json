    "params": [
      { "id": "prompt", "label": "提示词", "type": "text", "widget": "textarea", "required": true, "defaultValue": "" },
      { "id": "providerId", "label": "图像服务商 ID", "type": "text", "defaultValue": "" },
      { "id": "model", "label": "图像模型", "type": "text", "defaultValue": "" }
    ]
  },
  {
    "id": "preview.image",
    "label": "图片预览",
