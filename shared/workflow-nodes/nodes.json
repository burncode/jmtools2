    "outputs": [{ "id": "character", "kind": "character", "label": "角色" }],
    "params": [
      { "id": "actionId", "label": "动作", "type": "select", "defaultValue": "idle", "display": "inline", "options": [{ "label": "待机", "value": "idle" }, { "label": "行走", "value": "walk" }, { "label": "攻击", "value": "attack" }] },
      { "id": "viewKind", "label": "方向", "type": "select", "defaultValue": "auto", "display": "inline", "options": [{ "label": "全部", "value": "auto" }, { "label": "前", "value": "front" }, { "label": "后", "value": "back" }, { "label": "左", "value": "left" }, { "label": "右", "value": "right" }, { "label": "左前", "value": "frontLeft" }, { "label": "右前", "value": "frontRight" }, { "label": "左后", "value": "backLeft" }, { "label": "右后", "value": "backRight" }] },
      { "id": "previewFps", "label": "预览帧率", "type": "number", "widget": "slider", "defaultValue": 8, "display": "inline", "min": 1, "max": 60 }
    ]
  },
  {
    "id": "output.asset",
    "label": "输出资产",
